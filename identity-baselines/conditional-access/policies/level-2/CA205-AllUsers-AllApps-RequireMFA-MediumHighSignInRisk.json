{
  "displayName": "CA205-AllUsers-AllApps-RequireMFA-MediumHighSignInRisk",
  "state": "enabledForReportingButNotEnforced",
  "conditions": {
    "users": {
      "includeUsers": [
        "All"
      ],
      "excludeGroups": [
        "{{BREAK_GLASS_GROUP_ID}}"
      ]
    },
    "applications": {
      "includeApplications": [
        "All"
      ]
    },
    "clientAppTypes": [
      "all"
    ],
    "signInRiskLevels": [
      "medium",
      "high"
    ]
  },
  "grantControls": {
    "operator": "OR",
    "authenticationStrength": {
      "id": "00000000-0000-0000-0000-000000000002"
    }
  },
  "sessionControls": {
    "signInFrequency": {
      "isEnabled": true,
      "frequencyInterval": "everyTime",
      "authenticationType": "primaryAndSecondaryAuthentication"
    }
  }
}
